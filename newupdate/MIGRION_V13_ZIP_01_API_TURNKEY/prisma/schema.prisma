generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
  candidate Candidate?
  employer  Employer?
}

model Candidate {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  currentPhase Int     @default(1)
  phase1Paid   Boolean @default(false)
  phase1Done   Boolean @default(false)
  phase2Paid   Boolean @default(false)
  phase2Done   Boolean @default(false)
  phase3Paid   Boolean @default(false)
  escrowFunded Boolean @default(false)
  destination  String? // country slug chosen
  createdAt    DateTime @default(now())
  payments     Payment[]
  interviews   Interview[]
  escrowMilestones EscrowMilestone[]
}

model Employer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  company   String
  createdAt DateTime @default(now())
  purchases EmployerPurchase[]
  interviews Interview[]
}

model Payment {
  id          String   @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  phase       Int
  amountCents Int
  currency    String @default("USD")
  status      String
  provider    String
  createdAt   DateTime @default(now())
}

model EmployerPurchase {
  id          String   @id @default(uuid())
  employerId  String
  employer    Employer @relation(fields: [employerId], references: [id])
  sku         String
  amountCents Int
  currency    String @default("USD")
  status      String
  createdAt   DateTime @default(now())
}

model Interview {
  id          String   @id @default(uuid())
  employerId  String
  employer    Employer @relation(fields: [employerId], references: [id])
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  scheduledAt DateTime
  durationMin Int
  paid        Boolean @default(false)
  outcome     String  @default("pending")
  notes       String?
  createdAt   DateTime @default(now())
}

model EscrowMilestone {
  id           String   @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id])
  name         String
  requiredProof String
  status       String   @default("pending")
  releaseCents Int      @default(0)
  reference    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Referral {
  id         String   @id @default(uuid())
  type       String
  code       String   @unique
  name       String
  email      String
  createdAt  DateTime @default(now())
}

model Commission {
  id           String   @id @default(uuid())
  referralCode String
  candidateId  String
  phase        Int
  amountCents  Int
  status       String  @default("pending")
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  event     String
  payload   Json
  createdAt DateTime @default(now())
}

model Destination {
  slug      String @id
  name      String
  region    String
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
}

model ContentPage {
  id        String @id @default(uuid())
  slug      String @unique
  locale    String
  title     String
  metaTitle String
  metaDesc  String
  bodyMd    String
  videoUrl  String?
  createdAt DateTime @default(now())
}
